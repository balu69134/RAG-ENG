# Local answer generation (requires Ollama and the model below).
GENERATION_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300

# Qdrant uses local embedded storage by default. Leave the path blank to use QDRANT_URL.
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# Local embeddings and passage settings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=auto
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
MAX_UPLOAD_SIZE_MB=25

# Streamlit frontend URL for the FastAPI service.
RAG_API_URL=http://127.0.0.1:8000
